@page "/gallery"

<PageTitle>Gallery &amp; Portfolio | Spectrum Tattoo — Benton, TN</PageTitle>

<section class="section">
    <div class="container">
        <div class="section-header">
            <span class="eyebrow">Real Studio Work</span>
            <h1 class="section-title">Selected <em>Ink &amp; Sessions</em></h1>
            <p>
                Real tattoos and in-chair sessions from our all-women crew in Benton, TN. Follow our
                <a href="https://www.instagram.com/_spectrumtattoostudio_/" target="_blank" rel="noopener noreferrer" style="color: var(--accent-gold); text-decoration: underline;">Instagram</a>
                and
                <a href="https://www.facebook.com/Theoldcrowtattooparlor" target="_blank" rel="noopener noreferrer" style="color: var(--accent-gold); text-decoration: underline;">Facebook</a>
                for daily healed work and flash drops.
            </p>
        </div>

        <div class="filter-bar" role="tablist" aria-label="Filter gallery by style">
            @foreach (var cat in _categories)
            {
                <button type="button"
                        class="filter-btn @(_activeCategory == cat ? "active" : "")"
                        @onclick="() => _activeCategory = cat">
                    @cat
                </button>
            }
        </div>

        <div class="gallery-grid">
            @foreach (var piece in FilteredPieces)
            {
                <article class="gallery-card">
                    <div class="gallery-img-wrap">
                        <img src="@piece.ImagePath" alt="@piece.Alt" loading="lazy" />
                    </div>
                    <div class="gallery-meta">
                        <div class="gallery-sub">@piece.Category &middot; @piece.Artist</div>
                        <h3>@piece.Title</h3>
                        <p style="font-size: 0.88rem; margin: 0;">@piece.Notes</p>
                    </div>
                </article>
            }
        </div>
    </div>
</section>

@code {
    private string _activeCategory = "All";

    private readonly string[] _categories = ["All", "Watercolor & Pop Culture", "Botanical & Fine Line", "Blackwork & Surreal", "Color & Neo-Traditional", "In the Chair"];

    private sealed record GalleryPiece(string Title, string Category, string Artist, string ImagePath, string Alt, string Notes);

    private readonly List<GalleryPiece> _pieces =
    [
        new("Death Note Chest Piece", "Watercolor & Pop Culture", "Spectrum Tattoo", "images/tattoo-deathnote-chest.webp",
            "Custom Death Note chest tattoo featuring Ryuk, L, Light, and Near with watercolor splashes and wings",
            "Bold anime portraiture framed with wing silhouettes and vibrant watercolor accents."),
        new("InuYasha & Kagome Wrap", "Watercolor & Pop Culture", "Spectrum Tattoo", "images/tattoo-inuyasha-watercolor.webp",
            "Full-color InuYasha and Kagome watercolor sleeve wrap tattoo",
            "Luminous watercolor saturation and delicate cherry blossom detail."),
        new("Zelda & Navi Watercolor", "Watercolor & Pop Culture", "Spectrum Tattoo", "images/tattoo-zelda-watercolor.webp",
            "Legend of Zelda Sheik and Navi watercolor tattoo with vivid color splatters",
            "Crisp illustrative linework layered with bright prism watercolor splatters."),
        new("Botanical Watercolor Back Piece", "Botanical & Fine Line", "Spectrum Tattoo", "images/tattoo-botanical-back.webp",
            "Custom pink, teal, and violet watercolor floral back tattoo",
            "Flowing floral anatomy with soft translucent petal washes."),
        new("Aurora Pines & Silhouettes", "Watercolor & Pop Culture", "Spectrum Tattoo", "images/tattoo-aurora-pines.webp",
            "Pine forest and crescent moon watercolor aurora tattoo with silhouettes",
            "Atmospheric northern lights sky paired with crisp tree silhouettes."),
        new("Crimson & Violet Octopus", "Color & Neo-Traditional", "Spectrum Tattoo", "images/tattoo-crimson-octopus.webp",
            "Bold saturated red and purple octopus thigh tattoo",
            "Heavy color packing, expressive eye detail, and dynamic tentacle flow."),
        new("The Scream & Watercolor Roses", "Blackwork & Surreal", "Spectrum Tattoo", "images/tattoo-scream-roses.webp",
            "Dark surrealist cracked-porcelain Scream tattoo with stitched neck and watercolor roses",
            "Cracked-stone texture contrasted against violet and crimson watercolor roses."),
        new("Surrealist Dripping Eye", "Blackwork & Surreal", "Spectrum Tattoo", "images/tattoo-surreal-eye.webp",
            "Black and grey surrealist dripping eye tattoo",
            "Sharp stippling, organic drip linework, and expressive iris contrast."),
        new("Sugar Skull & Wolf Watercolor", "Watercolor & Pop Culture", "Spectrum Tattoo", "images/tattoo-sugarskull-wolf.webp",
            "Sugar skull portrait and wolf watercolor tattoo with custom script",
            "Dual portrait & wolf composition with dripping watercolor texture."),
        new("Portfolio Highlights", "Botanical & Fine Line", "Spectrum Tattoo", "images/tattoo-studio-collage.webp",
            "Seven-panel showcase of floral spine pieces, JoJo anime art, dagger, and mandala tattoos",
            "Spine florals, mandalas, anime, and neo-traditional daggers by our resident crew."),
        new("Sketch Raptor in Progress", "In the Chair", "Spectrum Tattoo", "images/artist-raptor-session.webp",
            "Spectrum Tattoo artist in black gloves tattooing a sketch-style dinosaur piece",
