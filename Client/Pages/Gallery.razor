        new("Fine-Line Botanical Session", "In the Chair", "Spectrum Tattoo", "images/studio-fineline-session.webp",
            "Artist tattooing delicate fine-line floral stems on a forearm",
            "Steady coil-machine linework in our Benton studio.")
    ];

    private IEnumerable<GalleryPiece> FilteredPieces =>
        _activeCategory == "All"
            ? _pieces
            : _pieces.Where(p => p.Category == _activeCategory);
}
