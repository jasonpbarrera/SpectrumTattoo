@page "/book"
@using System.Globalization
@using SpectrumTattoo.Client.Services
@inject LocalBookingService BookingService
@inject NavigationManager Nav

<PageTitle>Book a Consultation | Spectrum Tattoo — Benton, TN</PageTitle>

<section class="section">
    <div class="container">
        <div class="section-header">
            <span class="eyebrow">Calendar &amp; Artist Approval</span>
            <h1 class="section-title">Book Your <em>Session</em></h1>
            <p>
                Choose your artist, preferred date, and open time slot. Your artist will review and approve your concept before a non-refundable deposit is collected.
            </p>
        </div>

        @if (_lookupBooking is not null)
        {
            <div class="form-panel" style="margin-bottom: 2.5rem; border-color: var(--accent-gold);">
                <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem;">
                    <div>
                        <span class="eyebrow">Booking Status &middot; @_lookupBooking.Id</span>
                        <h2 style="font-size: 1.85rem; margin: 0.4rem 0;">@_lookupBooking.ServiceType with @_lookupBooking.Artist</h2>
                        <p style="margin: 0;">
                            <strong>@_lookupBooking.Date</strong> at <strong>@_lookupBooking.TimeSlot</strong>
                        </p>
                    </div>
                    <span class="status-badge @GetStatusClass(_lookupBooking.Status)">@FormatStatus(_lookupBooking.Status)</span>
                </div>

                @if (!string.IsNullOrWhiteSpace(_lookupBooking.ArtistNote))
                {
                    <p style="margin-top: 1rem; color: var(--text-bone);">
                        <strong>Artist Note:</strong> @_lookupBooking.ArtistNote
                    </p>
                }

                @if (_lookupBooking.Status == "ApprovedAwaitingDeposit")
                {
                    <div class="deposit-notice" style="margin-top: 1.25rem;">
                        <strong>Simulated Mode (Stripe Disabled):</strong> Your artist has approved this slot! Click below to simulate paying your <strong>$@((_lookupBooking.DepositAmountCents / 100.0).ToString("0.00"))</strong> non-refundable deposit and lock your calendar slot.
                    </div>
                    <div style="margin-top: 1rem; display: flex; flex-wrap: wrap; gap: 1rem; align-items: center;">
                        <button type="button" class="btn btn-primary" @onclick="() => SimulateDepositPaidAsync(_lookupBooking.Id)">
                            Simulate Deposit Paid ($@((_lookupBooking.DepositAmountCents / 100.0).ToString("0")))
                        </button>
                        <span style="font-size: 0.85rem; color: var(--text-ash);">Stripe checkout is currently disabled &middot; Simulated in-browser</span>
                    </div>
                }
                else if (_lookupBooking.Status == "Confirmed")
                {
                    <div style="margin-top: 1.25rem; display: flex; flex-wrap: wrap; gap: 1rem; align-items: center;">
                        <a href="@LocalBookingService.BuildIcsDataUri(_lookupBooking)" download="spectrum-tattoo-@(_lookupBooking.Id).ics" class="btn btn-outline btn-sm">Add to Calendar (.ics)</a>
                        <span style="font-size: 0.85rem; color: #86efac;">Deposit recorded &middot; Your appointment is locked in!</span>
                    </div>
                }
            </div>
        }

        <div class="book-layout">
            <div class="form-panel">
                @if (_submitted && _createdBooking is not null)
                {
                    <div style="padding: 1rem 0;">
                        <span class="eyebrow">Request Logged &middot; @_createdBooking.Id</span>
                        <h2 style="font-size: 2.2rem; margin: 0.85rem 0;">Pending Artist Approval</h2>
                        <p>
                            Thank you, <strong>@_createdBooking.Name</strong>. Your request for <strong>@_createdBooking.ServiceType</strong>
                            with <strong>@_createdBooking.Artist</strong> on <strong>@_createdBooking.Date</strong> at <strong>@_createdBooking.TimeSlot</strong> is now in the studio queue.
                        </p>
                        <div class="deposit-notice" style="margin: 1.25rem 0;">
                            <strong>Next Step (Simulated Mode):</strong> Open the <NavLink href="/studio-admin" style="color: var(--accent-gold); text-decoration: underline;">Studio Portal</NavLink> (PIN <code>4110</code>) to approve this request, then simulate the $@((_createdBooking.DepositAmountCents / 100.0).ToString("0")) deposit. Save your booking code: <strong style="color: var(--accent-gold);">@_createdBooking.Id</strong>.
                        </div>
                        <div style="display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.25rem;">
                            <a href="@LocalBookingService.BuildIcsDataUri(_createdBooking)" download="spectrum-tattoo-@(_createdBooking.Id).ics" class="btn btn-outline btn-sm">Download Calendar Hold (.ics)</a>
                            <button type="button" class="btn btn-primary btn-sm" @onclick="CheckCreatedStatus">Refresh Booking Status</button>
                            <button type="button" class="btn btn-outline btn-sm" @onclick="ResetForm">Book Another Session</button>
                        </div>
                    </div>
                }
                else
                {
                    <EditForm Model="_model" OnValidSubmit="HandleSubmit">
                        <DataAnnotationsValidator />

                        <div class="form-grid">
                            <div class="form-grid form-grid-2">
                                <div class="field-group">
                                    <label class="field-label" for="preferred-artist">1. Select Artist *</label>
                                    <select id="preferred-artist" class="field-select" value="@_model.PreferredArtist" @onchange="OnArtistChanged">
                                        <option value="First Available Artist">First Available Artist</option>
                                        <option value="Dawn Yermasek">Dawn Yermasek (Founder)</option>
                                        <option value="Tae">Tae</option>
                                        <option value="Kota">Kota</option>
                                        <option value="Kindra">Kindra</option>
                                        <option value="LaCinda">LaCinda</option>
                                        <option value="Heavenly Huckaby">Heavenly Huckaby</option>
                                    </select>
                                </div>

                                <div class="field-group">
                                    <label class="field-label" for="service-type">2. Service *</label>
                                    <InputSelect id="service-type" class="field-select" @bind-Value="_model.ServiceType">
                                        <option value="Custom Tattoo">Custom Tattoo</option>
                                        <option value="Scar Cover-Up / Rework">Scar Cover-Up / Rework</option>
                                        <option value="Flash Piece">Flash Piece</option>
                                        <option value="Piercing / Jewelry">Body Piercing / Jewelry Change</option>
                                        <option value="Permanent Makeup">Permanent Makeup</option>
                                    </InputSelect>
                                </div>
                            </div>

                            <div class="field-group">
                                <label class="field-label" for="booking-date">3. Choose Studio Date (Wed&ndash;Sun) *</label>
                                <input id="booking-date" type="date" class="field-input"
                                       min="@DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd")"
                                       value="@_model.Date"
                                       @onchange="OnDateChanged" />
                                <div class="date-quick-row">
                                    @foreach (var d in _upcomingOpenDates)
                                    {
                                        var iso = d.ToString("yyyy-MM-dd");
                                        <button type="button"
                                                class="date-chip @(_model.Date == iso ? "active" : "")"
                                                @onclick="() => SelectDate(iso)">
                                            @d.ToString("ddd MMM d")
                                        </button>
                                    }
                                </div>
                            </div>

                            <div class="field-group">
                                <label class="field-label">4. Select Available Time Slot *</label>
                                @if (_loadingSlots)
                                {
                                    <p style="font-size: 0.88rem; color: var(--text-smoke); margin: 0.25rem 0;">Checking artist calendar...</p>
                                }
                                else if (!_isStudioOpen)
                                {
                                    <p style="font-size: 0.9rem; color: #fda4af; margin: 0.25rem 0;">@_scheduleNote</p>
                                }
                                else
                                {
                                    <div class="slot-grid">
                                        @foreach (var slot in _slots)
                                        {
                                            <button type="button"
                                                    disabled="@(!slot.Available)"
                                                    class="slot-btn @(_model.TimeSlot == slot.Time ? "selected" : "")"
                                                    @onclick="() => _model.TimeSlot = slot.Time">
                                                @slot.Time
                                            </button>
                                        }
                                    </div>
                                    <span style="font-size: 0.78rem; color: var(--text-smoke); margin-top: 0.35rem;">@_scheduleNote</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(_slotError))
                                {
                                    <div class="validation-message">@_slotError</div>
                                }
                            </div>

                            <div class="form-grid form-grid-2">
                                <div class="field-group">
                                    <label class="field-label" for="client-name">Your Name *</label>
                                    <InputText id="client-name" class="field-input" @bind-Value="_model.Name" placeholder="Full name" />
                                    <ValidationMessage For="@(() => _model.Name)" class="validation-message" />
                                </div>

                                <div class="field-group">
                                    <label class="field-label" for="client-phone">Phone Number *</label>
                                    <InputText id="client-phone" class="field-input" @bind-Value="_model.Phone" placeholder="(423) 555-0199" />
                                    <ValidationMessage For="@(() => _model.Phone)" class="validation-message" />
                                </div>
                            </div>

                            <div class="form-grid form-grid-2">
                                <div class="field-group">
                                    <label class="field-label" for="client-email">Email Address *</label>
                                    <InputText id="client-email" type="email" class="field-input" @bind-Value="_model.Email" placeholder="you@example.com" />
                                    <ValidationMessage For="@(() => _model.Email)" class="validation-message" />
                                </div>

                                <div class="field-group">
                                    <label class="field-label" for="placement">Placement &amp; Approx. Size</label>
                                    <InputText id="placement" class="field-input" @bind-Value="_model.Placement" placeholder="e.g. Outer forearm, ~6 inches" />
                                </div>
                            </div>

                            <div class="field-group">
                                <label class="field-label" for="idea-desc">Tell Us Your Idea *</label>
                                <InputTextArea id="idea-desc" rows="4" class="field-textarea" @bind-Value="_model.IdeaDescription"
                                               placeholder="Describe your concept, style (watercolor, neo-traditional, fine-line, blackwork), color or black &amp; grey, and any cover-up notes." />
                                <ValidationMessage For="@(() => _model.IdeaDescription)" class="validation-message" />
                            </div>

                            <div class="deposit-notice">
                                <strong>Artist Approval &amp; Deposit Policy:</strong> No card is charged on request. Once your artist approves your concept and time, a <strong>non-refundable $@((_depositCents / 100.0).ToString("0")) deposit</strong> secures your appointment.
                            </div>

                            @if (!string.IsNullOrWhiteSpace(_submitError))
                            {
                                <div class="validation-message">@_submitError</div>
                            }

                            <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; margin-top: 0.25rem;">
                                <span style="font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-smoke);">
                                    18+ Valid Photo ID Required &middot; Cards Accepted
                                </span>
                                <button type="submit" class="btn btn-primary" disabled="@_submitting">
                                    @(_submitting ? "Requesting Slot..." : "Request Appointment Slot")
                                </button>
                            </div>
                        </div>
                    </EditForm>
                }
            </div>

            <aside style="display: flex; flex-direction: column; gap: 1.5rem;">
                <div class="info-panel">
                    <span class="eyebrow">Check Existing Request</span>
                    <h2 style="font-size: 1.55rem; margin: 0.6rem 0 0.75rem;">Booking Lookup</h2>
                    <div style="display: flex; gap: 0.5rem;">
                        <input type="text" class="field-input" @bind="_lookupCode" placeholder="e.g. ST-A1B2C3" />
                        <button type="button" class="btn btn-outline btn-sm" @onclick="LookupByCode">Check</button>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_lookupError))
                    {
                        <div class="validation-message" style="margin-top: 0.5rem;">@_lookupError</div>
                    }
                </div>

                <div class="info-panel">
                    <span class="eyebrow">Location &amp; Hours</span>
                    <h2 style="font-size: 1.85rem; margin: 0.75rem 0 0.5rem;">Spectrum Tattoo</h2>
                    <p style="margin-bottom: 0.75rem;">
                        6165 US-411<br />
                        Benton, TN 37307
                    </p>
                    <p style="margin-bottom: 1rem;">
                        <a href="tel:+14232999111" style="color: var(--accent-gold); font-family: var(--font-mono); font-size: 0.95rem;">
                            (423) 299-9111
                        </a>
                    </p>
                    <ul class="hours-list">
                        <li><span>Monday</span><span>Closed</span></li>
                        <li><span>Tuesday</span><span>Closed</span></li>
                        <li><span>Wednesday</span><span>10:00 AM &ndash; 6:00 PM</span></li>
                        <li><span>Thursday</span><span>10:00 AM &ndash; 6:00 PM</span></li>
                        <li><span>Friday</span><span>10:00 AM &ndash; 6:00 PM</span></li>
                        <li><span>Saturday</span><span>10:00 AM &ndash; 4:00 PM</span></li>
                        <li><span>Sunday</span><span>10:00 AM &ndash; 3:00 PM</span></li>
                    </ul>
                </div>

                <div class="info-panel">
                    <span class="eyebrow">Studio Notes</span>
                    <ul class="footer-links" style="margin-top: 1rem; gap: 0.75rem;">
                        <li>&bull; Formerly <strong style="color: var(--text-bone);">The Old Crow Tattoo Parlor</strong>—same studio, same US-411 location.</li>
                        <li>&bull; All deposits are <strong style="color: var(--text-bone);">non-refundable</strong> and apply toward your session.</li>
                        <li>&bull; Artists &amp; studio staff manage approvals in the <NavLink href="/studio-admin" style="color: var(--accent-gold); text-decoration: underline;">Studio Portal</NavLink>.</li>
                    </ul>
                </div>
            </aside>
        </div>
    </div>
</section>

@code {
    private ConsultationModel _model = new();
    private readonly List<DateOnly> _upcomingOpenDates = [];
    private List<SlotAvailability> _slots = [];
    private bool _loadingSlots;
    private bool _isStudioOpen = true;
    private string _scheduleNote = string.Empty;
    private int _depositCents = 5000;

    private bool _submitting;
    private bool _submitted;
    private string? _slotError;
    private string? _submitError;
    private LocalBookingRecord? _createdBooking;

    private string _lookupCode = string.Empty;
    private string? _lookupError;
    private LocalBookingRecord? _lookupBooking;

    protected override async Task OnInitializedAsync()
    {
        BuildUpcomingOpenDates();
        _model.Date = _upcomingOpenDates.First().ToString("yyyy-MM-dd");

        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = uri.Query;
        if (!string.IsNullOrEmpty(query))
        {
            if (query.Contains("artist=Dawn", StringComparison.OrdinalIgnoreCase)) _model.PreferredArtist = "Dawn Yermasek";
            else if (query.Contains("artist=Tae", StringComparison.OrdinalIgnoreCase)) _model.PreferredArtist = "Tae";
            else if (query.Contains("artist=Kota", StringComparison.OrdinalIgnoreCase)) _model.PreferredArtist = "Kota";
            else if (query.Contains("artist=Kindra", StringComparison.OrdinalIgnoreCase)) _model.PreferredArtist = "Kindra";
            else if (query.Contains("artist=LaCinda", StringComparison.OrdinalIgnoreCase)) _model.PreferredArtist = "LaCinda";
            else if (query.Contains("artist=Heavenly", StringComparison.OrdinalIgnoreCase)) _model.PreferredArtist = "Heavenly Huckaby";

            if (query.Contains("Cover-Up", StringComparison.OrdinalIgnoreCase)) _model.ServiceType = "Scar Cover-Up / Rework";
            else if (query.Contains("Piercing", StringComparison.OrdinalIgnoreCase)) _model.ServiceType = "Piercing / Jewelry";

            var parsed = System.Web.HttpUtility.ParseQueryString(query);
            var bookingId = parsed["bookingId"];
            if (!string.IsNullOrWhiteSpace(bookingId))
            {
                _lookupCode = bookingId;
                await LookupByCode();
            }
        }

        await LoadAvailabilityAsync();
    }

    private void BuildUpcomingOpenDates()
    {
        _upcomingOpenDates.Clear();
        var cursor = DateOnly.FromDateTime(DateTime.Today.AddDays(1));
        while (_upcomingOpenDates.Count < 5)
        {
            if (cursor.DayOfWeek is not DayOfWeek.Monday and not DayOfWeek.Tuesday)
                _upcomingOpenDates.Add(cursor);
            cursor = cursor.AddDays(1);
        }
    }

    private async Task OnArtistChanged(ChangeEventArgs e)
    {
        _model.PreferredArtist = e.Value?.ToString() ?? "First Available Artist";
        await LoadAvailabilityAsync();
    }

    private async Task OnDateChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        if (!string.IsNullOrWhiteSpace(val))
            await SelectDate(val);
    }

    private async Task SelectDate(string isoDate)
    {
        _model.Date = isoDate;
        _model.TimeSlot = string.Empty;
        _slotError = null;
        await LoadAvailabilityAsync();
    }

    private async Task LoadAvailabilityAsync()
    {
        _loadingSlots = true;
        try
        {
            var (isOpen, note, slots) = await BookingService.GetAvailabilityAsync(_model.PreferredArtist, _model.Date);
            _isStudioOpen = isOpen;
            _scheduleNote = note;
            _slots = slots;
            if (string.IsNullOrWhiteSpace(_model.TimeSlot) || !_slots.Any(s => s.Time == _model.TimeSlot && s.Available))
            {
                _model.TimeSlot = _slots.FirstOrDefault(s => s.Available)?.Time ?? string.Empty;
            }
        }
        finally
        {
            _loadingSlots = false;
        }
    }

    private async Task HandleSubmit()
    {
        _slotError = null;
        _submitError = null;

        if (!_isStudioOpen || string.IsNullOrWhiteSpace(_model.TimeSlot))
        {
            _slotError = "Please select an open studio date and available time slot.";
            return;
        }

        _submitting = true;
        try
        {
            _createdBooking = await BookingService.CreateAsync(new LocalBookingRecord
            {
                Artist = _model.PreferredArtist,
                Date = _model.Date,
                TimeSlot = _model.TimeSlot,
                ServiceType = _model.ServiceType,
                Name = _model.Name,
                Phone = _model.Phone,
                Email = _model.Email,
                Placement = _model.Placement,
                IdeaDescription = _model.IdeaDescription,
                Status = "PendingApproval",
                DepositAmountCents = _depositCents,
                DepositPaid = false
            });
            _submitted = true;
            await LoadAvailabilityAsync();
        }
        catch
        {
            _submitError = "Could not save booking request locally. Please try again.";
        }
        finally
        {
            _submitting = false;
        }
    }

    private async Task CheckCreatedStatus()
    {
        if (_createdBooking is null) return;
        _lookupCode = _createdBooking.Id;
        await LookupByCode();
    }

    private async Task LookupByCode()
    {
        _lookupError = null;
        var code = _lookupCode.Trim().ToUpperInvariant();
        if (string.IsNullOrWhiteSpace(code)) return;

        var found = await BookingService.GetAsync(code);
        if (found is not null)
        {
            _lookupBooking = found;
            return;
        }

        _lookupError = $"No booking found for code {code}.";
    }

    private async Task SimulateDepositPaidAsync(string id)
    {
        await BookingService.UpdateStatusAsync(id, "Confirmed", depositPaid: true);
        _lookupBooking = await BookingService.GetAsync(id);
        if (_createdBooking is not null && string.Equals(_createdBooking.Id, id, StringComparison.OrdinalIgnoreCase))
            _createdBooking = _lookupBooking;
        await LoadAvailabilityAsync();
    }

    private void ResetForm()
    {
        var currentArtist = _model.PreferredArtist;
        _model = new()
        {
            PreferredArtist = currentArtist,
            Date = _upcomingOpenDates.First().ToString("yyyy-MM-dd")
        };
        _submitted = false;
        _createdBooking = null;
        _ = LoadAvailabilityAsync();
    }

    private static string GetStatusClass(string status) => status switch
    {
        "Confirmed" => "status-confirmed",
        "ApprovedAwaitingDeposit" => "status-awaiting",
        "Declined" => "status-declined",
        _ => "status-pending"
    };

    private static string FormatStatus(string status) => status switch
    {
        "Confirmed" => "Confirmed · Deposit Paid",
        "ApprovedAwaitingDeposit" => "Approved · Deposit Due",
        "Declined" => "Declined",
        _ => "Pending Artist Approval"
    };

    public sealed class ConsultationModel
    {
        [Required(ErrorMessage = "Please enter your name.")]
        public string Name { get; set; } = string.Empty;

        [Required(ErrorMessage = "Please enter a phone number.")]
        public string Phone { get; set; } = string.Empty;

        [Required(ErrorMessage = "Please enter an email address.")]
        [EmailAddress(ErrorMessage = "Please enter a valid email address.")]
        public string Email { get; set; } = string.Empty;

        public string PreferredArtist { get; set; } = "First Available Artist";
        public string ServiceType { get; set; } = "Custom Tattoo";
        public string Date { get; set; } = string.Empty;
        public string TimeSlot { get; set; } = string.Empty;
        public string Placement { get; set; } = string.Empty;

        [Required(ErrorMessage = "Please describe your tattoo or piercing idea.")]
        [MinLength(10, ErrorMessage = "Please share a few more details about your idea.")]
        public string IdeaDescription { get; set; } = string.Empty;
    }
}
