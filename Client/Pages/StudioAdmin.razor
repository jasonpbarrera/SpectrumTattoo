    private static string[] BuildTimeOptions()
    {
        var list = new List<string>();
        for (int mins = 8 * 60; mins <= 21 * 60; mins += 30)
        {
            list.Add(DateTime.Today.AddMinutes(mins).ToString("h:mm tt", System.Globalization.CultureInfo.InvariantCulture));
        }
        return [.. list];
    }

    private IEnumerable<LocalBookingRecord> ArtistFiltered =>
        _artistFilter == "All"
            ? _bookings
            : _bookings.Where(b => string.Equals(b.Artist, _artistFilter, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<LocalBookingRecord> FilteredBookings =>
        _statusFilter == "All"
            ? ArtistFiltered
            : ArtistFiltered.Where(b => b.Status == _statusFilter);

    private int CountByStatus(string key) =>
        key == "All" ? ArtistFiltered.Count() : ArtistFiltered.Count(b => b.Status == key);

    private void SetSection(string section)
    {
        _activeSection = section;
        _actionError = null;
        _actionNotice = null;
    }

    private async Task UnlockAsync()
    {
        _authError = null;
        _loading = true;
        try
        {
            await LoadDashboardAsync();
            if (_authError is null)
                _unlocked = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private IEnumerable<ClientProfileRecord> FilteredClients
    {
        get
        {
            var term = _clientSearch.Trim();
            if (string.IsNullOrWhiteSpace(term)) return _clients;
            var digits = LocalBookingService.NormalizePhone(term);
            return _clients.Where(c =>
                (digits.Length >= 3 && c.PhoneKey.Contains(digits, StringComparison.OrdinalIgnoreCase))
                || c.Name.Contains(term, StringComparison.OrdinalIgnoreCase)
                || c.Email.Contains(term, StringComparison.OrdinalIgnoreCase)
                || c.Phone.Contains(term, StringComparison.OrdinalIgnoreCase)
                || c.StudioNotes.Contains(term, StringComparison.OrdinalIgnoreCase));
        }
    }

    private ClientProfileRecord? GetClientProfile(string? phone)
    {
        var key = LocalBookingService.NormalizePhone(phone);
        if (key.Length < 7) return null;
        return _clients.FirstOrDefault(c => string.Equals(c.PhoneKey, key, StringComparison.OrdinalIgnoreCase));
    }

    private List<LocalBookingRecord> GetClientBookings(string? phone)
    {
        var key = LocalBookingService.NormalizePhone(phone);
        if (key.Length < 7) return [];
        return _bookings
            .Where(b => string.Equals(LocalBookingService.NormalizePhone(b.Phone), key, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(b => b.Date)
            .ToList();
    }

    private void OpenClientProfile(string phone)
    {
        _clientSearch = phone;
        SetSection("clients");
    }

    private async Task SaveClientNotesAsync(ClientProfileRecord c)
    {
        var notes = _clientNotes.TryGetValue(c.PhoneKey, out var n) ? n : string.Empty;
        await RunActionAsync(
            () => BookingService.SaveClientProfileAsync(_pin, c.Phone, c.Name, c.Email, notes),
            $"Saved private notes for {(string.IsNullOrWhiteSpace(c.Name) ? c.Phone : c.Name)}.");
    }

    private void LockPortal()
    {
        _unlocked = false;
        _pin = string.Empty;
        _bookings = [];
        _blocks = [];
        _schedules = [];
        _clients = [];
        _clientSearch = string.Empty;
        _confirmDeleteId = null;
        _lightboxImage = null;
        _actionError = null;
        _actionNotice = null;
    }

    private async Task LoadDashboardAsync()
    {
        _actionError = null;
        try
        {
            var data = await BookingService.LoadAdminDataAsync(_pin);
            _bookings = data.Bookings;
            _blocks = data.Blocks;
            _schedules = data.Schedules;
            _clients = data.Clients;

            foreach (var c in _clients)
            {
                _clientNotes[c.PhoneKey] = c.StudioNotes ?? string.Empty;
            }

            foreach (var b in _bookings)
            {
                _notes[b.Id] = b.ArtistNote ?? string.Empty;
                _depositDollars[b.Id] = Math.Max(10, b.DepositAmountCents / 100);
                _editDate[b.Id] = b.Date;
                _editStart[b.Id] = _timeOptions.Contains(b.TimeSlot) ? b.TimeSlot : "10:00 AM";
                var defaultEnd = ComputeDefaultEnd(b.TimeSlot);
                _editEnd[b.Id] = !string.IsNullOrWhiteSpace(b.EndTime) && _timeOptions.Contains(b.EndTime)
                    ? b.EndTime
                    : defaultEnd;
            }

            LoadEditingSchedule(_selectedScheduleArtist);
        }
        catch (UnauthorizedAccessException)
        {
            _authError = "Invalid studio PIN.";
        }
        catch
        {
            _authError = "Unable to reach the booking service.";
        }
    }

    private static string ComputeDefaultEnd(string start)
    {
        if (DateTime.TryParseExact(start, "h:mm tt", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var dt))
            return dt.AddMinutes(90).ToString("h:mm tt", System.Globalization.CultureInfo.InvariantCulture);
        return "11:30 AM";
    }

    private void OnScheduleArtistChanged(ChangeEventArgs e)
    {
        _selectedScheduleArtist = e.Value?.ToString() ?? _artists[0];
        LoadEditingSchedule(_selectedScheduleArtist);
    }

    private void LoadEditingSchedule(string artist)
    {
        var found = _schedules.FirstOrDefault(s => string.Equals(s.Artist, artist, StringComparison.OrdinalIgnoreCase));
        var map = new Dictionary<string, DaySchedule>(StringComparer.OrdinalIgnoreCase);
        foreach (var d in _daysOfWeek)
        {
            if (found is not null && found.Days.TryGetValue(d, out var existing))
            {
                map[d] = new DaySchedule
                {
                    Enabled = existing.Enabled,
                    StartTime = existing.StartTime,
                    EndTime = existing.EndTime
                };
            }
            else
            {
                map[d] = new DaySchedule
                {
                    Enabled = d is not "Monday" and not "Tuesday",
                    StartTime = "10:00 AM",
                    EndTime = d == "Saturday" ? "4:00 PM" : d == "Sunday" ? "3:00 PM" : "6:00 PM"
                };
            }
        }
        _editingDays = map;
    }

    private async Task SaveBookingEditsAsync(string id)
    {
        var dollars = _depositDollars.TryGetValue(id, out var d) && d >= 10 ? d : 50;
        var note = _notes.TryGetValue(id, out var n) ? n : null;
        var date = _editDate.TryGetValue(id, out var dt) ? dt : null;
        var start = _editStart.TryGetValue(id, out var st) ? st : null;
        var end = _editEnd.TryGetValue(id, out var en) ? en : null;
        await RunActionAsync(
            () => BookingService.UpdateStatusAsync(id, "update-booking", _pin, artistNote: note, depositCents: dollars * 100, date: date, timeSlot: start, endTime: end),
            "Appointment time and details saved.");
    }

