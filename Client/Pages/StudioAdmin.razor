@page "/studio-admin"
@using SpectrumTattoo.Client.Services
@inject LocalBookingService BookingService
@inject NavigationManager Nav

<PageTitle>Studio Portal | Spectrum Tattoo</PageTitle>

<section class="section">
    <div class="container">
        <div class="section-header">
            <span class="eyebrow">Artist &amp; Studio Portal</span>
            <h1 class="section-title">Booking <em>Approvals</em> &amp; Schedule</h1>
            <p>
                Manage appointment requests, adjust session start and end times, block time off, and configure weekly artist schedules.
            </p>
        </div>

        @if (!_unlocked)
        {
            <form class="form-panel" style="max-width: 440px;" @onsubmit="UnlockAsync" @onsubmit:preventDefault="true">
                <span class="eyebrow">Studio Access</span>
                <h2 style="font-size: 1.65rem; margin: 0.6rem 0 1rem;">Enter Studio PIN</h2>
                <div class="field-group">
                    <label class="field-label" for="studio-pin">PIN</label>
                    <input id="studio-pin" type="password" class="field-input" @bind="_pin" @bind:event="oninput" placeholder="Enter studio PIN" autocomplete="current-password" />
                </div>
                @if (!string.IsNullOrWhiteSpace(_authError))
                {
                    <div class="validation-message" style="margin-top: 0.6rem;">@_authError</div>
                }
                <button type="submit" class="btn btn-primary" style="margin-top: 1.25rem;" disabled="@_loading">
                    @(_loading ? "Checking..." : "Unlock Portal")
                </button>
            </form>
        }
        else
        {
            <div style="margin-bottom: 1.5rem; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem;">
                <div class="gallery-filters" style="margin: 0;">
                    <button type="button" class="filter-pill @(_activeSection == "bookings" ? "active" : "")" @onclick='() => SetSection("bookings")'>
                        Bookings (@_bookings.Count)
                    </button>
                    <button type="button" class="filter-pill @(_activeSection == "clients" ? "active" : "")" @onclick='() => SetSection("clients")'>
                        Clients (@_clients.Count)
                    </button>
                    <button type="button" class="filter-pill @(_activeSection == "blocks" ? "active" : "")" @onclick='() => SetSection("blocks")'>
                        Block Time Off (@_blocks.Count)
                    </button>
                    <button type="button" class="filter-pill @(_activeSection == "schedules" ? "active" : "")" @onclick='() => SetSection("schedules")'>
                        Artist Schedules
                    </button>
                </div>
                <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                    <button type="button" class="btn btn-outline btn-sm" @onclick="LoadDashboardAsync">Refresh</button>
                    <button type="button" class="btn btn-outline btn-sm" @onclick="LockPortal">Lock</button>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_actionNotice))
            {
                <div class="deposit-notice" style="margin-bottom: 1.25rem; border-color: rgba(134,239,172,0.5); color: #86efac;">@_actionNotice</div>
            }
            @if (!string.IsNullOrWhiteSpace(_actionError))
            {
                <div class="validation-message" style="margin-bottom: 1rem;">@_actionError</div>
            }

            @if (_activeSection == "bookings")
            {
                <div style="margin-bottom: 1.25rem; display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem;">
                    <label class="field-label" for="artist-filter" style="margin: 0;">Artist:</label>
                    <select id="artist-filter" class="field-select" style="width: auto; min-width: 210px;" @bind="_artistFilter">
                        <option value="All">All Artists (@_bookings.Count)</option>
                        @foreach (var a in _artists)
                        {
                            <option value="@a">@a</option>
                        }
                        <option value="First Available Artist">First Available Artist</option>
                    </select>
                </div>

                <div class="gallery-filters" style="margin-bottom: 1.5rem;">
                    @foreach (var tab in _statusTabs)
                    {
                        <button type="button"
                                class="filter-pill @(_statusFilter == tab.Key ? "active" : "")"
                                @onclick="() => _statusFilter = tab.Key">
                            @tab.Label (@CountByStatus(tab.Key))
                        </button>
                    }
                </div>

                @if (!FilteredBookings.Any())
                {
                    <div class="form-panel">
                        <p style="margin: 0; color: var(--text-ash);">No booking requests match this filter.</p>
                    </div>
                }
                else
                {
                    <div class="admin-booking-list">
                        @foreach (var b in FilteredBookings)
                        {
                            <article class="admin-booking-card">
                                <div class="admin-booking-top">
                                    <div>
                                        <span class="eyebrow">@b.Id &middot; @b.Artist</span>
                                        <h2 style="font-size: 1.65rem; margin: 0.35rem 0;">@b.Name &mdash; @b.ServiceType</h2>
                                        <div style="font-family: var(--font-mono); font-size: 0.84rem; color: var(--accent-gold);">
                                            @b.Date &middot; @b.TimeSlot@(!string.IsNullOrWhiteSpace(b.EndTime) ? $" – {b.EndTime}" : "") &middot; Deposit: $@((b.DepositAmountCents / 100.0).ToString("0.00"))
                                            @if (b.DepositPaid)
                                            {
                                                <span style="color: #86efac;"> &middot; Paid</span>
                                            }
                                        </div>
                                    </div>
                                    <span class="status-badge @GetStatusClass(b.Status)">@FormatStatus(b.Status)</span>
                                </div>

                                <p style="margin-bottom: 0.5rem;">
                                    <strong>Contact:</strong> <a href="tel:@b.Phone" style="color: var(--accent-gold);">@b.Phone</a> &middot; <a href="mailto:@b.Email" style="color: var(--text-bone);">@b.Email</a>
                                    @if (!string.IsNullOrWhiteSpace(b.Placement))
                                    {
                                        <span> &middot; <strong>Placement:</strong> @b.Placement</span>
                                    }
                                </p>
                                @{
                                    var clientProf = GetClientProfile(b.Phone);
                                    var clientVisits = GetClientBookings(b.Phone);
                                }
                                <div style="margin: 0.65rem 0 0.85rem; padding: 0.7rem 0.9rem; border: 1px solid rgba(229,193,133,0.28); background: rgba(229,193,133,0.05); display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-start; gap: 0.75rem;">
                                    <div style="flex: 1; min-width: 220px;">
                                        <div style="font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent-gold); font-weight: 600;">
                                            @(clientVisits.Count > 1 ? $"Returning Client · {clientVisits.Count} Appointments" : "Client Profile · 1st Request")
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(clientProf?.StudioNotes))
                                        {
                                            <div style="font-size: 0.88rem; color: var(--text-bone); margin-top: 0.25rem;">
                                                <strong>Private Studio Notes:</strong> @clientProf.StudioNotes
                                            </div>
                                        }
                                        else
                                        {
                                            <div style="font-size: 0.82rem; color: var(--text-smoke); margin-top: 0.2rem;">
                                                No private studio notes yet.
                                            </div>
                                        }
                                    </div>
                                    <button type="button" class="btn btn-outline btn-sm" @onclick="() => OpenClientProfile(b.Phone)">
                                        @(string.IsNullOrWhiteSpace(clientProf?.StudioNotes) ? "Add Client Note" : "Edit Client Profile")
                                    </button>
                                </div>
                                <p style="margin-bottom: 0.75rem; color: var(--text-bone);">@b.IdeaDescription</p>

                                @if (b.ReferenceImages is { Count: > 0 })
                                {
                                    <div style="margin-bottom: 0.85rem;">
                                        <span class="field-label" style="display: block; margin-bottom: 0.35rem;">Client Reference Photos (click to zoom)</span>
                                        <div class="ref-photo-grid">
                                            @for (var i = 0; i < b.ReferenceImages.Count; i++)
                                            {
                                                var imgSrc = b.ReferenceImages[i];
                                                <div class="ref-photo-item">
                                                    <img src="@imgSrc" alt="Reference photo @(i + 1) for @b.Name" @onclick="() => _lightboxImage = imgSrc" />
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }

                                <div class="form-grid" style="grid-template-columns: repeat(auto-fit, minmax(155px, 1fr)); margin-top: 0.75rem;">
                                    <div class="field-group">
                                        <label class="field-label">Date</label>
                                        <input type="date" class="field-input" value="@_editDate[b.Id]" @onchange="e => _editDate[b.Id] = e.Value?.ToString() ?? b.Date" />
                                    </div>
                                    <div class="field-group">
                                        <label class="field-label">Start Time</label>
                                        <select class="field-select" @bind="_editStart[b.Id]">
                                            @foreach (var t in _timeOptions)
                                            {
                                                <option value="@t">@t</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="field-group">
                                        <label class="field-label">End Time</label>
                                        <select class="field-select" @bind="_editEnd[b.Id]">
                                            @foreach (var t in _timeOptions)
                                            {
                                                <option value="@t">@t</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="field-group">
                                        <label class="field-label">Deposit (USD)</label>
                                        <input type="number" min="10" step="5" class="field-input" @bind="_depositDollars[b.Id]" />
                                    </div>
                                </div>

                                <div class="field-group" style="margin-top: 0.75rem;">
                                    <label class="field-label">Artist Note (optional)</label>
                                    <input type="text" class="field-input" @bind="_notes[b.Id]" placeholder="e.g. Extended 3-hour block; please bring reference" />
                                </div>

                                <div class="admin-actions-row">
                                    @if (b.Status == "PendingApproval")
                                    {
                                        <button type="button" class="btn btn-primary btn-sm" @onclick="() => ApproveAsync(b.Id)">
                                            Approve &amp; Request Deposit
                                        </button>
                                    }
                                    @if (b.Status is "PendingApproval" or "ApprovedAwaitingDeposit")
                                    {
                                        <button type="button" class="btn btn-outline btn-sm" @onclick="() => ConfirmManualAsync(b.Id)">
                                            Mark Deposit Paid
                                        </button>
                                    }
                                    @if (b.Status is "PendingApproval" or "ApprovedAwaitingDeposit" or "Confirmed")
                                    {
                                        <button type="button" class="btn btn-outline btn-sm" @onclick="() => SaveBookingEditsAsync(b.Id)">
                                            Save Time &amp; Note
                                        </button>
                                    }
                                    @if (b.Status == "Confirmed")
                                    {
                                        <button type="button" class="btn btn-primary btn-sm" @onclick="() => CompleteAsync(b.Id)">
                                            Mark Completed
                                        </button>
                                    }
                                    @if (b.Status == "PendingApproval")
                                    {
                                        <button type="button" class="btn btn-outline btn-sm" style="border-color: rgba(253,164,175,0.45); color: #fda4af;" @onclick="() => DeclineAsync(b.Id)">
                                            Decline
                                        </button>
                                    }
                                    @if (b.Status is "ApprovedAwaitingDeposit" or "Confirmed")
                                    {
                                        <button type="button" class="btn btn-outline btn-sm" style="border-color: rgba(253,164,175,0.45); color: #fda4af;" @onclick="() => CancelAsync(b.Id)">
                                            Cancel Appointment
                                        </button>
                                    }
                                    @if (b.ReferenceImages is { Count: > 0 })
                                    {
                                        <button type="button" class="btn btn-outline btn-sm" @onclick="() => ClearPhotosAsync(b.Id)">
                                            Clear Photos
                                        </button>
                                    }
                                    <a href="/book?bookingId=@b.Id" class="btn btn-outline btn-sm">Client Status Link</a>
                                    <a href="@LocalBookingService.BuildIcsDataUri(b)" download="spectrum-tattoo-@(b.Id).ics" class="btn btn-outline btn-sm">.ics Calendar</a>

                                    @if (_confirmDeleteId == b.Id)
                                    {
                                        <button type="button" class="btn btn-outline btn-sm" style="border-color: #f87171; color: #fca5a5;" @onclick="() => DeleteAsync(b.Id)">
                                            Confirm Delete
                                        </button>
                                        <button type="button" class="btn btn-outline btn-sm" @onclick="() => _confirmDeleteId = null">Keep</button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-outline btn-sm" style="border-color: rgba(248,113,113,0.4); color: #fca5a5;" @onclick="() => _confirmDeleteId = b.Id">
                                            Delete
                                        </button>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                }
            }
            else if (_activeSection == "clients")
            {
                <div class="form-panel" style="margin-bottom: 1.5rem;">
                    <span class="eyebrow">Private Studio Directory</span>
                    <h2 style="font-size: 1.55rem; margin: 0.45rem 0 0.75rem;">Client Profiles &amp; Artist Notes</h2>
                    <p style="font-size: 0.88rem; color: var(--text-ash); margin-bottom: 1rem;">
                        Profiles are created automatically when clients book and are keyed by phone number. Studio notes are private to artists and never shown to clients.
                    </p>
                    <div class="field-group" style="max-width: 420px;">
                        <label class="field-label" for="client-search">Lookup by Phone Number, Name, or Email</label>
                        <input id="client-search" type="text" class="field-input" @bind="_clientSearch" @bind:event="oninput" placeholder="e.g. (423) 555-0199 or name" />
                    </div>
                </div>

                @if (!FilteredClients.Any())
                {
                    <div class="form-panel">
                        <p style="margin: 0; color: var(--text-ash);">No client profiles match your search.</p>
                    </div>
                }
                else
                {
                    <div class="admin-booking-list">
                        @foreach (var c in FilteredClients)
                        {
                            var history = GetClientBookings(c.PhoneKey);
                            <article class="admin-booking-card">
                                <div class="admin-booking-top">
                                    <div>
                                        <span class="eyebrow">@c.Phone &middot; @history.Count @(history.Count == 1 ? "Appointment" : "Appointments")</span>
                                        <h2 style="font-size: 1.55rem; margin: 0.35rem 0;">@(string.IsNullOrWhiteSpace(c.Name) ? "Unnamed Client" : c.Name)</h2>
                                        <div style="font-size: 0.88rem; color: var(--text-ash);">
                                            <a href="tel:@c.Phone" style="color: var(--accent-gold);">@c.Phone</a>
                                            @if (!string.IsNullOrWhiteSpace(c.Email))
                                            {
                                                <span> &middot; <a href="mailto:@c.Email" style="color: var(--text-bone);">@c.Email</a></span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(c.PreferredArtist))
                                            {
                                                <span> &middot; Preferred Artist: <strong style="color: var(--text-bone);">@c.PreferredArtist</strong></span>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <div class="field-group" style="margin-top: 0.5rem;">
                                    <label class="field-label">Private Studio / Artist Notes (hidden from client)</label>
                                    <textarea rows="3" class="field-textarea" @bind="_clientNotes[c.PhoneKey]" placeholder="e.g. Sits great for long sessions, working on floral half-sleeve, prefers numbing spray, skin notes..."></textarea>
                                </div>

                                <div style="margin-top: 0.75rem;">
                                    <button type="button" class="btn btn-primary btn-sm" @onclick="() => SaveClientNotesAsync(c)">Save Client Notes</button>
                                </div>

                                @{
                                    var clientPhotos = history
                                        .Where(h => h.ReferenceImages is { Count: > 0 })
                                        .SelectMany(h => h.ReferenceImages.Select(img => (h.Date, h.ServiceType, Img: img)))
                                        .ToList();
                                }
                                @if (clientPhotos.Count > 0)
                                {
                                    <div style="margin-top: 1rem;">
                                        <span class="field-label" style="display: block; margin-bottom: 0.35rem;">Saved Reference Photos (click to zoom)</span>
                                        <div class="ref-photo-grid">
                                            @foreach (var p in clientPhotos)
                                            {
                                                var imgSrc = p.Img;
                                                <div class="ref-photo-item" title="@p.Date · @p.ServiceType">
                                                    <img src="@imgSrc" alt="Reference photo from @p.Date" @onclick="() => _lightboxImage = imgSrc" />
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }

                                @if (history.Count > 0)
                                {
                                    <div style="margin-top: 1.15rem; padding-top: 0.9rem; border-top: 1px solid var(--hairline);">
                                        <span class="field-label" style="display: block; margin-bottom: 0.5rem;">Appointment History</span>
                                        <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                                            @foreach (var h in history)
                                            {
                                                <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 0.5rem; font-size: 0.86rem; padding: 0.45rem 0.65rem; background: rgba(255,255,255,0.02); border: 1px solid var(--hairline);">
                                                    <div>
                                                        <strong>@h.Date</strong> &middot; @h.TimeSlot@(!string.IsNullOrWhiteSpace(h.EndTime) ? $" – {h.EndTime}" : "") &middot; @h.Artist &middot; @h.ServiceType
                                                        @if (!string.IsNullOrWhiteSpace(h.Placement))
                                                        {
                                                            <span style="color: var(--text-smoke);"> (@h.Placement)</span>
                                                        }
                                                    </div>
                                                    <span class="status-badge @GetStatusClass(h.Status)">@FormatStatus(h.Status)</span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </article>
                        }
                    </div>
                }
            }
            else if (_activeSection == "blocks")
            {
                <div class="form-panel" style="margin-bottom: 1.5rem;">
                    <span class="eyebrow">Add Time Off / Closure</span>
                    <h2 style="font-size: 1.55rem; margin: 0.45rem 0 1rem;">Block Out Calendar Time</h2>
                    <div class="form-grid" style="grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));">
                        <div class="field-group">
                            <label class="field-label" for="blk-artist">Artist</label>
                            <select id="blk-artist" class="field-select" @bind="_newBlockArtist">
                                <option value="All Artists">All Artists (Studio Closed)</option>
                                @foreach (var a in _artists)
                                {
                                    <option value="@a">@a</option>
                                }
                            </select>
                        </div>
                        <div class="field-group">
                            <label class="field-label" for="blk-date">Date</label>
                            <input id="blk-date" type="date" class="field-input" @bind="_newBlockDate" />
                        </div>
                        <div class="field-group" style="justify-content: flex-end;">
                            <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-size: 0.9rem; color: var(--text-bone); padding: 0.6rem 0;">
                                <input type="checkbox" @bind="_newBlockAllDay" />
                                Full Day Off
                            </label>
                        </div>
                    </div>

                    @if (!_newBlockAllDay)
                    {
                        <div class="form-grid form-grid-2" style="margin-top: 0.75rem;">
                            <div class="field-group">
                                <label class="field-label" for="blk-start">Start Time</label>
                                <select id="blk-start" class="field-select" @bind="_newBlockStart">
                                    @foreach (var t in _timeOptions)
                                    {
                                        <option value="@t">@t</option>
                                    }
                                </select>
                            </div>
                            <div class="field-group">
                                <label class="field-label" for="blk-end">End Time</label>
                                <select id="blk-end" class="field-select" @bind="_newBlockEnd">
                                    @foreach (var t in _timeOptions)
                                    {
                                        <option value="@t">@t</option>
                                    }
                                </select>
                            </div>
                        </div>
                    }

                    <div class="field-group" style="margin-top: 0.75rem;">
                        <label class="field-label" for="blk-reason">Reason (optional)</label>
                        <input id="blk-reason" type="text" class="field-input" @bind="_newBlockReason" placeholder="e.g. Private full-day piece, Vacation, Holiday" />
                    </div>

                    <div style="margin-top: 1.1rem;">
                        <button type="button" class="btn btn-primary btn-sm" @onclick="AddBlockAsync">Add Time Block</button>
                    </div>
                </div>

                @if (_blocks.Count == 0)
                {
                    <div class="form-panel">
                        <p style="margin: 0; color: var(--text-ash);">No upcoming time blocks configured.</p>
                    </div>
                }
                else
                {
                    <div class="admin-booking-list">
                        @foreach (var bl in _blocks)
                        {
                            <article class="admin-booking-card" style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem;">
                                <div>
                                    <span class="eyebrow">@bl.Artist</span>
                                    <div style="font-size: 1.15rem; font-weight: 600; margin: 0.25rem 0;">
                                        @bl.Date &middot; @(bl.AllDay ? "Full Day Off" : $"{bl.StartTime} – {bl.EndTime}")
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(bl.Reason))
                                    {
                                        <div style="font-size: 0.88rem; color: var(--text-ash);">@bl.Reason</div>
                                    }
                                </div>
                                <button type="button" class="btn btn-outline btn-sm" style="border-color: rgba(248,113,113,0.45); color: #fca5a5;" @onclick="() => DeleteBlockAsync(bl.Id)">
                                    Remove Block
                                </button>
                            </article>
                        }
                    </div>
                }
            }
            else if (_activeSection == "schedules")
            {
                <div class="form-panel">
                    <span class="eyebrow">Recurring Weekly Availability</span>
                    <h2 style="font-size: 1.55rem; margin: 0.45rem 0 1rem;">Artist Weekly Schedule</h2>

                    <div class="field-group" style="max-width: 300px; margin-bottom: 1.25rem;">
                        <label class="field-label" for="sched-artist">Select Artist</label>
                        <select id="sched-artist" class="field-select" value="@_selectedScheduleArtist" @onchange="OnScheduleArtistChanged">
                            @foreach (var a in _artists)
                            {
                                <option value="@a">@a</option>
                            }
                        </select>
                    </div>

                    <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                        @foreach (var dayName in _daysOfWeek)
                        {
                            if (_editingDays.TryGetValue(dayName, out var day))
                            {
                                <div style="display: grid; grid-template-columns: 140px 1fr 1fr; gap: 0.75rem; align-items: center; padding: 0.65rem 0.75rem; border: 1px solid var(--hairline); background: rgba(255,255,255,0.02);">
                                    <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-weight: 600; color: @(day.Enabled ? "var(--text-bone)" : "var(--text-smoke)");">
                                        <input type="checkbox" @bind="day.Enabled" />
                                        @dayName
                                    </label>
                                    @if (day.Enabled)
                                    {
                                        <select class="field-select" @bind="day.StartTime">
                                            @foreach (var t in _timeOptions)
                                            {
                                                <option value="@t">@t</option>
                                            }
                                        </select>
                                        <select class="field-select" @bind="day.EndTime">
                                            @foreach (var t in _timeOptions)
                                            {
                                                <option value="@t">@t</option>
                                            }
                                        </select>
                                    }
                                    else
                                    {
                                        <span style="grid-column: span 2; font-size: 0.85rem; color: var(--text-smoke);">Off / Unavailable</span>
                                    }
                                </div>
                            }
                        }
                    </div>

                    <div style="margin-top: 1.25rem;">
                        <button type="button" class="btn btn-primary btn-sm" @onclick="SaveScheduleAsync">Save @_selectedScheduleArtist's Schedule</button>
                    </div>
                </div>
            }
        }
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(_lightboxImage))
{
    <div class="photo-lightbox" @onclick="() => _lightboxImage = null">
        <button type="button" class="photo-lightbox-close" aria-label="Close photo" @onclick="() => _lightboxImage = null">&times;</button>
        <img src="@_lightboxImage" alt="Client reference photo full size" @onclick:stopPropagation="true" />
    </div>
}

@code {
    private static readonly string[] _artists =
    [
        "Dawn Yermasek",
        "Tae",
        "Kota",
