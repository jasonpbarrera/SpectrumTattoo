    private async Task RunActionAsync(Func<Task> action, string? successMessage = null)
    {
        _actionError = null;
        _actionNotice = null;
        try
        {
            await action();
            await LoadDashboardAsync();
            _actionNotice = successMessage;
        }
        catch (InvalidOperationException ex)
        {
            _actionError = ex.Message;
        }
        catch
        {
            _actionError = "Could not complete that action. Please refresh and try again.";
        }
    }

    private static string GetStatusClass(string status) => status switch
    {
        "Confirmed" or "Completed" => "status-confirmed",
        "ApprovedAwaitingDeposit" => "status-awaiting",
        "Declined" or "Cancelled" => "status-declined",
        _ => "status-pending"
    };

    private static string FormatStatus(string status) => status switch
    {
        "Confirmed" => "Confirmed",
        "Completed" => "Completed",
        "ApprovedAwaitingDeposit" => "Awaiting Deposit",
        "Declined" => "Declined",
        "Cancelled" => "Cancelled",
        _ => "Pending Approval"
    };
