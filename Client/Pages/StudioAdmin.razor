@page "/studio-admin"
@using SpectrumTattoo.Client.Services
@inject LocalBookingService BookingService
@inject NavigationManager Nav

<PageTitle>Studio Portal | Spectrum Tattoo</PageTitle>

<section class="section">
    <div class="container">
        <div class="section-header">
            <span class="eyebrow">Artist &amp; Studio Portal</span>
            <h1 class="section-title">Booking <em>Approvals</em> &amp; Schedule</h1>
            <p>
                Review incoming appointment requests, filter by artist, approve slots, manage deposits, or cancel and delete bookings.
            </p>
        </div>

        @if (!_unlocked)
        {
            <form class="form-panel" style="max-width: 440px;" @onsubmit="UnlockAsync">
                <span class="eyebrow">Studio Access</span>
                <h2 style="font-size: 1.65rem; margin: 0.6rem 0 1rem;">Enter Studio PIN</h2>
                <div class="field-group">
                    <label class="field-label" for="studio-pin">PIN</label>
                    <input id="studio-pin" type="password" class="field-input" @bind="_pin" placeholder="Enter studio PIN" autocomplete="current-password" />
                </div>
                @if (!string.IsNullOrWhiteSpace(_authError))
                {
                    <div class="validation-message" style="margin-top: 0.6rem;">@_authError</div>
                }
                <button type="submit" class="btn btn-primary" style="margin-top: 1.25rem;" disabled="@_loading">
                    @(_loading ? "Checking..." : "Unlock Portal")
                </button>
            </form>
        }
        else
        {
            <div style="margin-bottom: 1.5rem; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem;">
                <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem;">
                    <label class="field-label" for="artist-filter" style="margin: 0;">Artist:</label>
                    <select id="artist-filter" class="field-select" style="width: auto; min-width: 200px;" @bind="_artistFilter">
                        <option value="All">All Artists (@_bookings.Count)</option>
                        <option value="Dawn Yermasek">Dawn Yermasek</option>
                        <option value="Tae">Tae</option>
                        <option value="Kota">Kota</option>
                        <option value="Kindra">Kindra</option>
                        <option value="LaCinda">LaCinda</option>
                        <option value="Heavenly Huckaby">Heavenly Huckaby</option>
                        <option value="First Available Artist">First Available Artist</option>
                    </select>
                </div>
                <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                    <button type="button" class="btn btn-outline btn-sm" @onclick="LoadBookingsAsync">Refresh</button>
                    <button type="button" class="btn btn-outline btn-sm" @onclick="LockPortal">Lock</button>
                </div>
            </div>

            <div class="gallery-filters" style="margin-bottom: 1.5rem;">
                @foreach (var tab in _statusTabs)
                {
                    <button type="button"
                            class="filter-pill @(_statusFilter == tab.Key ? "active" : "")"
                            @onclick="() => _statusFilter = tab.Key">
                        @tab.Label (@CountByStatus(tab.Key))
                    </button>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(_actionError))
            {
                <div class="validation-message" style="margin-bottom: 1rem;">@_actionError</div>
            }

            @if (!FilteredBookings.Any())
            {
                <div class="form-panel">
                    <p style="margin: 0; color: var(--text-ash);">No booking requests match this filter.</p>
                </div>
            }
            else
            {
                <div class="admin-booking-list">
                    @foreach (var b in FilteredBookings)
                    {
                        <article class="admin-booking-card">
                            <div class="admin-booking-top">
                                <div>
                                    <span class="eyebrow">@b.Id &middot; @b.Artist</span>
                                    <h2 style="font-size: 1.65rem; margin: 0.35rem 0;">@b.Name &mdash; @b.ServiceType</h2>
                                    <div style="font-family: var(--font-mono); font-size: 0.84rem; color: var(--accent-gold);">
                                        @b.Date &middot; @b.TimeSlot &middot; Deposit: $@((b.DepositAmountCents / 100.0).ToString("0.00"))
                                        @if (b.DepositPaid)
                                        {
                                            <span style="color: #86efac;"> &middot; Paid</span>
                                        }
                                    </div>
                                </div>
                                <span class="status-badge @GetStatusClass(b.Status)">@FormatStatus(b.Status)</span>
                            </div>

                            <p style="margin-bottom: 0.5rem;">
                                <strong>Contact:</strong> <a href="tel:@b.Phone" style="color: var(--accent-gold);">@b.Phone</a> &middot; <a href="mailto:@b.Email" style="color: var(--text-bone);">@b.Email</a>
                                @if (!string.IsNullOrWhiteSpace(b.Placement))
                                {
                                    <span> &middot; <strong>Placement:</strong> @b.Placement</span>
                                }
                            </p>
                            <p style="margin-bottom: 0.75rem; color: var(--text-bone);">@b.IdeaDescription</p>

                            @if (b.ReferenceImages is { Count: > 0 })
                            {
                                <div style="margin-bottom: 0.85rem;">
                                    <span class="field-label" style="display: block; margin-bottom: 0.35rem;">Client Reference Photos (click to zoom)</span>
                                    <div class="ref-photo-grid">
                                        @for (var i = 0; i < b.ReferenceImages.Count; i++)
                                        {
                                            var imgSrc = b.ReferenceImages[i];
                                            <div class="ref-photo-item">
                                                <img src="@imgSrc" alt="Reference photo @(i + 1) for @b.Name" @onclick="() => _lightboxImage = imgSrc" />
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            <div class="form-grid form-grid-2" style="margin-top: 0.75rem;">
                                <div class="field-group">
                                    <label class="field-label">Artist Note (optional)</label>
                                    <input type="text" class="field-input" @bind="_notes[b.Id]" placeholder="e.g. Please bring reference photo; 2-hour block" />
                                </div>
                                <div class="field-group">
                                    <label class="field-label">Deposit Amount (USD)</label>
                                    <input type="number" min="10" step="5" class="field-input" @bind="_depositDollars[b.Id]" />
                                </div>
                            </div>

                            <div class="admin-actions-row">
                                @if (b.Status == "PendingApproval")
                                {
                                    <button type="button" class="btn btn-primary btn-sm" @onclick="() => ApproveAsync(b.Id)">
                                        Approve &amp; Request Deposit
                                    </button>
                                }
                                @if (b.Status is "PendingApproval" or "ApprovedAwaitingDeposit")
                                {
                                    <button type="button" class="btn btn-outline btn-sm" @onclick="() => ConfirmManualAsync(b.Id)">
                                        Mark Deposit Paid
                                    </button>
                                }
                                @if (b.Status == "Confirmed")
                                {
                                    <button type="button" class="btn btn-primary btn-sm" @onclick="() => CompleteAsync(b.Id)">
                                        Mark Completed
                                    </button>
                                }
                                @if (b.Status == "PendingApproval")
                                {
                                    <button type="button" class="btn btn-outline btn-sm" style="border-color: rgba(253,164,175,0.45); color: #fda4af;" @onclick="() => DeclineAsync(b.Id)">
                                        Decline
                                    </button>
                                }
                                @if (b.Status is "ApprovedAwaitingDeposit" or "Confirmed")
                                {
                                    <button type="button" class="btn btn-outline btn-sm" style="border-color: rgba(253,164,175,0.45); color: #fda4af;" @onclick="() => CancelAsync(b.Id)">
                                        Cancel Appointment
                                    </button>
                                }
                                @if (b.ReferenceImages is { Count: > 0 })
                                {
                                    <button type="button" class="btn btn-outline btn-sm" @onclick="() => ClearPhotosAsync(b.Id)">
                                        Clear Photos
                                    </button>
                                }
                                <a href="/book?bookingId=@b.Id" class="btn btn-outline btn-sm">Client Status Link</a>
                                <a href="@LocalBookingService.BuildIcsDataUri(b)" download="spectrum-tattoo-@(b.Id).ics" class="btn btn-outline btn-sm">.ics Calendar</a>

                                @if (_confirmDeleteId == b.Id)
                                {
                                    <button type="button" class="btn btn-outline btn-sm" style="border-color: #f87171; color: #fca5a5;" @onclick="() => DeleteAsync(b.Id)">
                                        Confirm Delete
                                    </button>
                                    <button type="button" class="btn btn-outline btn-sm" @onclick="() => _confirmDeleteId = null">Keep</button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-outline btn-sm" style="border-color: rgba(248,113,113,0.4); color: #fca5a5;" @onclick="() => _confirmDeleteId = b.Id">
                                        Delete
                                    </button>
                                }
                            </div>
                        </article>
                    }
                </div>
            }
        }
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(_lightboxImage))
{
    <div class="photo-lightbox" @onclick="() => _lightboxImage = null">
        <button type="button" class="photo-lightbox-close" aria-label="Close photo" @onclick="() => _lightboxImage = null">&times;</button>
        <img src="@_lightboxImage" alt="Client reference photo full size" @onclick:stopPropagation="true" />
    </div>
}

@code {
    private string _pin = string.Empty;
    private bool _unlocked;
    private bool _loading;
    private string? _authError;
    private string? _actionError;
    private string _statusFilter = "All";
    private string _artistFilter = "All";
    private string? _confirmDeleteId;
    private string? _lightboxImage;
    private List<LocalBookingRecord> _bookings = [];
    private readonly Dictionary<string, string> _notes = new();
    private readonly Dictionary<string, int> _depositDollars = new();

    private readonly (string Key, string Label)[] _statusTabs =
    [
        ("All", "All"),
        ("PendingApproval", "Pending"),
        ("ApprovedAwaitingDeposit", "Awaiting Deposit"),
        ("Confirmed", "Confirmed"),
        ("Completed", "Completed"),
        ("Cancelled", "Cancelled"),
        ("Declined", "Declined")
    ];

    private IEnumerable<LocalBookingRecord> ArtistFiltered =>
        _artistFilter == "All"
            ? _bookings
            : _bookings.Where(b => string.Equals(b.Artist, _artistFilter, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<LocalBookingRecord> FilteredBookings =>
        _statusFilter == "All"
            ? ArtistFiltered
            : ArtistFiltered.Where(b => b.Status == _statusFilter);

    private int CountByStatus(string key) =>
        key == "All" ? ArtistFiltered.Count() : ArtistFiltered.Count(b => b.Status == key);

    private async Task UnlockAsync()
    {
        _authError = null;
        _loading = true;
        try
        {
            await LoadBookingsAsync();
            if (_authError is null)
                _unlocked = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private void LockPortal()
    {
        _unlocked = false;
        _pin = string.Empty;
        _bookings = [];
        _confirmDeleteId = null;
        _lightboxImage = null;
        _actionError = null;
    }

    private async Task LoadBookingsAsync()
    {
        _actionError = null;
        try
        {
            _bookings = await BookingService.ListAsync(_pin);
            foreach (var b in _bookings)
            {
                if (!_notes.ContainsKey(b.Id))
                    _notes[b.Id] = b.ArtistNote ?? string.Empty;
                if (!_depositDollars.ContainsKey(b.Id))
                    _depositDollars[b.Id] = Math.Max(10, b.DepositAmountCents / 100);
            }
        }
        catch (UnauthorizedAccessException)
        {
            _authError = "Invalid studio PIN.";
        }
        catch
        {
            _authError = "Unable to reach the booking service.";
        }
    }

    private async Task ApproveAsync(string id)
    {
        var dollars = _depositDollars.TryGetValue(id, out var d) && d >= 10 ? d : 50;
        var note = _notes.TryGetValue(id, out var n) ? n : null;
        await RunActionAsync(() => BookingService.UpdateStatusAsync(id, "approve", _pin, artistNote: note, depositCents: dollars * 100));
    }

    private async Task ConfirmManualAsync(string id)
    {
        var dollars = _depositDollars.TryGetValue(id, out var d) && d >= 10 ? d : 50;
        var note = _notes.TryGetValue(id, out var n) ? n : null;
        await RunActionAsync(() => BookingService.UpdateStatusAsync(id, "confirm", _pin, artistNote: note, depositCents: dollars * 100));
    }

    private async Task CompleteAsync(string id)
    {
        var note = _notes.TryGetValue(id, out var n) ? n : null;
        await RunActionAsync(() => BookingService.UpdateStatusAsync(id, "complete", _pin, artistNote: note));
    }

    private async Task ClearPhotosAsync(string id)
    {
        await RunActionAsync(() => BookingService.UpdateStatusAsync(id, "clear-photos", _pin));
    }

    private async Task DeclineAsync(string id)
    {
        var note = _notes.TryGetValue(id, out var n) ? n : null;
        await RunActionAsync(() => BookingService.UpdateStatusAsync(id, "decline", _pin, artistNote: note));
    }

    private async Task CancelAsync(string id)
    {
        var note = _notes.TryGetValue(id, out var n) ? n : null;
        await RunActionAsync(() => BookingService.UpdateStatusAsync(id, "cancel", _pin, artistNote: note));
    }

    private async Task DeleteAsync(string id)
    {
        _confirmDeleteId = null;
        await RunActionAsync(() => BookingService.UpdateStatusAsync(id, "delete", _pin));
    }

    private async Task RunActionAsync(Func<Task> action)
    {
        _actionError = null;
        try
        {
            await action();
            await LoadBookingsAsync();
        }
        catch
        {
            _actionError = "Could not complete that action. Please refresh and try again.";
        }
    }

    private static string GetStatusClass(string status) => status switch
    {
        "Confirmed" or "Completed" => "status-confirmed",
        "ApprovedAwaitingDeposit" => "status-awaiting",
        "Declined" or "Cancelled" => "status-declined",
        _ => "status-pending"
    };

    private static string FormatStatus(string status) => status switch
    {
        "Confirmed" => "Confirmed",
        "Completed" => "Completed",
        "ApprovedAwaitingDeposit" => "Awaiting Deposit",
        "Declined" => "Declined",
        "Cancelled" => "Cancelled",
        _ => "Pending Approval"
    };
}
