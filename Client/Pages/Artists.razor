@page "/artists"

<PageTitle>Artists | Spectrum Tattoo — Benton, TN</PageTitle>

<section class="section">
    <div class="container">
        <div class="section-header">
            <span class="eyebrow">The Collective</span>
            <h1 class="section-title">Meet the <em>Artists</em></h1>
            <p>
                Every artist at Spectrum Tattoo brings distinct technical mastery—united by spotless hygiene, patient communication, and a fierce respect for your story.
            </p>
        </div>

        <div class="artist-grid">
            <article class="artist-card">
                <span class="artist-role">Founder &amp; Lead Artist</span>
                <h2 class="artist-name">Dawn Yermasek</h2>
                <p>
                    The creative force behind the studio from its Old Crow roots to Spectrum Tattoo. Dawn is renowned across East Tennessee for her remarkably light hand, clean healing, vibrant watercolor blends, neo-traditional moths and florals, and detailed nerd/pop-culture pieces.
                </p>
                <div class="craft-tags">
                    <span class="craft-tag">Watercolor</span>
                    <span class="craft-tag">Neo-Traditional</span>
                    <span class="craft-tag">Botanicals</span>
                    <span class="craft-tag">Pop Culture</span>
                </div>
                <div style="margin-top: auto; padding-top: 1rem;">
                    <NavLink href="/book?artist=Dawn" class="btn btn-outline btn-sm">Consult with Dawn</NavLink>
                </div>
            </article>

            <article class="artist-card">
                <span class="artist-role">Resident Tattoo Artist</span>
                <h2 class="artist-name">Tae</h2>
                <p>
                    Beloved by long-time regulars for her patience, warm demeanor, and deeply expressive custom work. Tae specializes in turning personal milestones into cohesive, lasting tattoos in a calm, zero-pressure chair.
                </p>
                <div class="craft-tags">
                    <span class="craft-tag">Custom Illustrative</span>
                    <span class="craft-tag">Color Saturation</span>
                    <span class="craft-tag">Memorials</span>
                </div>
                <div style="margin-top: auto; padding-top: 1rem;">
                    <NavLink href="/book?artist=Tae" class="btn btn-outline btn-sm">Consult with Tae</NavLink>
                </div>
            </article>

            <article class="artist-card">
                <span class="artist-role">Resident Tattoo Artist</span>
                <h2 class="artist-name">Kota</h2>
                <p>
                    Focused on originality and crisp linework, Kota crafts custom designs with bold contrast, balanced composition, and vibrant color saturation built to hold for decades.
                </p>
                <div class="craft-tags">
                    <span class="craft-tag">Original Flash</span>
                    <span class="craft-tag">Crisp Linework</span>
                    <span class="craft-tag">Color</span>
                </div>
                <div style="margin-top: auto; padding-top: 1rem;">
                    <NavLink href="/book?artist=Kota" class="btn btn-outline btn-sm">Consult with Kota</NavLink>
                </div>
            </article>

            <article class="artist-card">
                <span class="artist-role">Resident Tattoo Artist</span>
                <h2 class="artist-name">Kindra</h2>
                <p>
                    Known for meticulous attention to detail and a welcoming, reassuring presence—especially for clients working through anxiety or getting their very first piece.
                </p>
                <div class="craft-tags">
                    <span class="craft-tag">Fine Line</span>
                    <span class="craft-tag">Botanical</span>
                    <span class="craft-tag">Custom Pieces</span>
                </div>
                <div style="margin-top: auto; padding-top: 1rem;">
                    <NavLink href="/book?artist=Kindra" class="btn btn-outline btn-sm">Consult with Kindra</NavLink>
                </div>
            </article>

            <article class="artist-card">
                <span class="artist-role">Resident Tattoo Artist</span>
                <h2 class="artist-name">LaCinda</h2>
                <p>
                    Blending gothic elegance, music-inspired imagery, and sharp blackwork with subtle detail—creating pieces that feel both deeply personal and unmistakably badass.
                </p>
                <div class="craft-tags">
                    <span class="craft-tag">Blackwork</span>
                    <span class="craft-tag">Gothic &amp; Music</span>
                    <span class="craft-tag">Custom Flash</span>
                </div>
                <div style="margin-top: auto; padding-top: 1rem;">
                    <NavLink href="/book?artist=LaCinda" class="btn btn-outline btn-sm">Consult with LaCinda</NavLink>
                </div>
            </article>
        </div>
    </div>
</section>
