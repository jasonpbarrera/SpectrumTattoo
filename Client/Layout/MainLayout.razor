@inherits LayoutComponentBase

<div class="studio-strip">
    <div class="container studio-strip-inner">
        <div class="studio-strip-group">
            <span>6165 US-411 &middot; Benton, TN 37307</span>
            <span class="studio-strip-hide-sm">&bull;</span>
            <span class="studio-strip-hide-sm">Formerly The Old Crow Tattoo Parlor</span>
        </div>
        <div class="studio-strip-group">
            <span>Wed&ndash;Fri 10&ndash;6 &middot; Sat 10&ndash;4 &middot; Sun 10&ndash;3</span>
            <span>&bull;</span>
            <a href="tel:+14232999111">(423) 299-9111</a>
        </div>
    </div>
</div>

<header class="site-header">
    <div class="container header-inner">
        <a href="/" class="brand-lockup" @onclick="CloseMenu">
            <svg viewBox="0 0 64 64" width="38" height="38" fill="none" aria-hidden="true">
                <polygon points="32,4 58,52 6,52" stroke="#E5C185" stroke-width="1.6" />
                <line x1="32" y1="12" x2="32" y2="58" stroke="#C43B4F" stroke-width="1.6" />
                <circle cx="32" cy="34" r="5" stroke="#E5C185" stroke-width="1.3" />
            </svg>
            <span class="brand-title-group">
                <span class="brand-name">Spectrum Tattoo</span>
                <span class="brand-sub">Benton, Tennessee</span>
            </span>
        </a>

        <nav class="desktop-nav" aria-label="Primary Navigation">
            <NavLink href="/" Match="NavLinkMatch.All" class="nav-link">Studio</NavLink>
            <NavLink href="/artists" class="nav-link">Artists</NavLink>
            <NavLink href="/services" class="nav-link">Services</NavLink>
            <NavLink href="/gallery" class="nav-link">Gallery</NavLink>
            <NavLink href="/book" class="nav-link">Consult</NavLink>
        </nav>

        <div class="header-actions">
            <NavLink href="/book" class="btn btn-primary btn-sm header-book-btn">Book Ink</NavLink>
            <button type="button"
                    class="mobile-menu-btn"
                    aria-label="Toggle navigation menu"
                    aria-expanded="@_mobileMenuOpen"
                    @onclick="ToggleMenu">
                @(_mobileMenuOpen ? "✕" : "☰")
            </button>
        </div>
    </div>

    @if (_mobileMenuOpen)
    {
        <nav class="mobile-drawer" aria-label="Mobile Navigation">
            <NavLink href="/" Match="NavLinkMatch.All" class="nav-link" @onclick="CloseMenu">Studio</NavLink>
            <NavLink href="/artists" class="nav-link" @onclick="CloseMenu">Artists</NavLink>
            <NavLink href="/services" class="nav-link" @onclick="CloseMenu">Services &amp; Aftercare</NavLink>
            <NavLink href="/gallery" class="nav-link" @onclick="CloseMenu">Gallery</NavLink>
            <NavLink href="/book" class="nav-link" @onclick="CloseMenu">Book Consultation</NavLink>
            <div class="mobile-drawer-ctas">
                <a href="tel:+14232999111" class="btn btn-outline btn-sm" @onclick="CloseMenu">Call Studio</a>
                <NavLink href="/book" class="btn btn-primary btn-sm" @onclick="CloseMenu">Book Ink</NavLink>
            </div>
        </nav>
    }
</header>

<main>
    @Body
</main>

<footer class="site-footer">
    <div class="container">
        <div class="footer-grid">
            <div>
                <div class="brand-lockup" style="margin-bottom: 1rem;">
                    <svg viewBox="0 0 64 64" width="32" height="32" fill="none" aria-hidden="true">
                        <polygon points="32,4 58,52 6,52" stroke="#E5C185" stroke-width="1.6" />
                        <line x1="32" y1="12" x2="32" y2="58" stroke="#C43B4F" stroke-width="1.6" />
                    </svg>
                    <span class="brand-title-group">
                        <span class="brand-name" style="font-size: 1.25rem;">Spectrum Tattoo</span>
                        <span class="brand-sub">Est. Benton, TN</span>
                    </span>
                </div>
                <p style="font-size: 0.92rem; max-width: 36ch;">
                    Custom tattooing, body piercing, and permanent makeup on US-411. Formerly The Old Crow Tattoo Parlor—same fierce artistry, new name.
                </p>
            </div>

            <div>
                <div class="footer-heading">Studio</div>
                <ul class="footer-links">
                    <li><NavLink href="/">Home</NavLink></li>
                    <li><NavLink href="/artists">Meet the Artists</NavLink></li>
                    <li><NavLink href="/services">Services &amp; Aftercare</NavLink></li>
                    <li><NavLink href="/gallery">Tattoo &amp; Flash Gallery</NavLink></li>
                    <li><NavLink href="/book">Book a Consultation</NavLink></li>
                </ul>
            </div>

            <div>
                <div class="footer-heading">Hours</div>
                <ul class="footer-links">
                    <li>Mon &ndash; Tue: Closed</li>
                    <li>Wed &ndash; Fri: 10 AM &ndash; 6 PM</li>
                    <li>Saturday: 10 AM &ndash; 4 PM</li>
                    <li>Sunday: 10 AM &ndash; 3 PM</li>
                </ul>
            </div>

            <div>
                <div class="footer-heading">Visit &amp; Connect</div>
                <ul class="footer-links">
                    <li>6165 US-411, Benton, TN 37307</li>
                    <li><a href="tel:+14232999111">(423) 299-9111</a></li>
                    <li>
                        <a href="https://www.instagram.com/_spectrumtattoostudio_/" target="_blank" rel="noopener noreferrer">
                            Instagram (@("@_spectrumtattoostudio_"))
                        </a>
                    </li>
                    <li>
                        <a href="https://www.facebook.com/Theoldcrowtattooparlor" target="_blank" rel="noopener noreferrer">
                            Facebook (@("@Theoldcrowtattooparlor"))
                        </a>
                    </li>
                    <li>Accepts Credit Cards &middot; Free Wi-Fi</li>
                </ul>
            </div>
        </div>

        <div class="footer-bottom">
            <span>&copy; @DateTime.UtcNow.Year Spectrum Tattoo. All rights reserved.</span>
            <div class="footer-legal-links">
                <NavLink href="/privacy">Privacy Policy</NavLink>
                <NavLink href="/terms">Terms of Service</NavLink>
            </div>
            <span class="jb-attribution">
                v@(_version) &middot; @(_buildDate) &middot; Powered by
                <a href="https://jbdigitalservices.net" target="_blank" rel="noopener noreferrer">JB Digital Services</a>
            </span>
        </div>
    </div>
</footer>

@code {
    private bool _mobileMenuOpen;
    private string _version = "1.0.0";
    private string _buildDate = "Nov 18, 2026";

    protected override void OnInitialized()
    {
        var asm = typeof(MainLayout).Assembly;
        var ver = asm.GetName().Version;
        if (ver is not null)
        {
            _version = $"{ver.Major}.{ver.Minor}.{ver.Build}";
        }

        var buildMeta = asm.GetCustomAttributes<AssemblyMetadataAttribute>()
            .FirstOrDefault(a => a.Key == "BuildTimestamp")?.Value;
        if (!string.IsNullOrWhiteSpace(buildMeta))
        {
            _buildDate = buildMeta;
        }
    }

    private void ToggleMenu() => _mobileMenuOpen = !_mobileMenuOpen;
    private void CloseMenu() => _mobileMenuOpen = false;
}
